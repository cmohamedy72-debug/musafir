{
  // Réglages Cloudflare : pages HTML servies telles quelles + un petit programme (src/worker.js)
  // qui enregistre la liste d'attente dans un stockage KV (créé automatiquement au déploiement).
  "name": "musafir",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "ATTENTE" }
  ]
}
